--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -267,6 +267,10 @@
 config GENERIC_CALIBRATE_DELAY
 	def_bool y
 
+config ZONE_DMA
+	bool "Support DMA zone (as the EcoNet 5.4.55 kernel)"
+	default y
+
 config ZONE_DMA32
 	bool "Support DMA32 zone" if EXPERT
 	default y
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -856,6 +856,11 @@
 		__u32		reserved_tailroom;
 	};
 
+	/* EcoNet/Airoha 5.4.55 vendor ABI: 8 bytes after mark (164..171),
+	 * copied with the headers (__copy_skb_header memcpy 128..188).
+	 */
+	__u8			ecnt_vendor_mark[8];
+
 	union {
 		__be16		inner_protocol;
 		__u8		inner_ipproto;
@@ -874,6 +879,18 @@
 	__u32			headers_end[0];
 	/* public: */
 
+	/* EcoNet/Airoha 5.4.55 vendor ABI: 420-byte HW NAT/QDMA block
+	 * (188..607) after headers_end, copied field by field by the vendor's
+	 * __copy_skb_header; tail moves 180 -> 608. hw_nat.ko reads the PPE
+	 * flow tag here (hwnat_skb_to_foe): magic at 204, FOE entry at 206,
+	 * CPU reason (low 5 bits) at 208. A zero magic is a packet the PPE did
+	 * not see (__alloc_skb zeroes the block).
+	 */
+	__u8			ecnt_vendor_hwnat0[16];
+	__u16			ecnt_foe_magic;
+	__u16			ecnt_foe_entry;
+	__u8			ecnt_vendor_hwnat1[400];
+
 	/* These elements must be at the end, see alloc_skb() for details.  */
 	sk_buff_data_t		tail;
 	sk_buff_data_t		end;
