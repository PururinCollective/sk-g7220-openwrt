 	struct gro_list		gro_hash[GRO_HASH_BUCKETS];
 	struct sk_buff		*skb;
 	struct list_head	rx_list; /* Pending GRO_NORMAL skbs */
@@ -1939,6 +1943,10 @@
  * Cache lines mostly used on receive path (including eth_type_trans())
  */
