// RemixWrt rpcd backend (ubus object "aero"): bridges LuCI to the stock
// EcoNet userland in the /vendor chroot. The stock web pages talk to the
// stock skapid objects (rtweb.*, gwweb.*) on the stock message bus; this
// backend calls the same methods on that bus (/vendor/tmp/run/ubus/ubus.sock)
// for the LuCI pages, restricted to the methods in
// /usr/share/aero/vcall.json (read / write lists, so the rpcd ACL can
// grant read-only access).

'use strict';

import { popen, open, readfile, writefile, unlink, access, mkdir, stat, rename } from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';

const VSOCK = '/vendor/tmp/run/ubus/ubus.sock';
const VUP = '/tmp/aero/vendor.up';
const ALLOW_FILE = '/usr/share/aero/vcall.json';
const AES_IV_HEX = '30303030303030303030303030303030';	// '0000000000000000', as the stock web page

let allow = null;

function load_allow() {
	if (allow == null) {
		try { allow = json(readfile(ALLOW_FILE)); }
		catch (e) { allow = { read: {}, write: {} }; }
	}
	return allow;
}

function allowed(kind, object, method) {
	const a = load_allow();
	const list = a?.[kind]?.[object];
	if (type(list) != 'array')
		return false;
	return index(list, method) >= 0 || index(list, '*') >= 0;
}

// the vendor bus is there (the stock rc chain may still be running)
function vendor_up() {
	return !!access(VSOCK);
}

function vconnect() {
	if (!access(VSOCK))
		return null;
	return connect(VSOCK, 15);
}

// one call on an open connection: { result } or { error }
function vcall_on(conn, object, method, params) {
	const r = conn.call(object, method, params ?? {});
	if (r == null) {
		const e = conn.error();
		return { error: e ? `${object}.${method}: ${e}` : `${object}.${method}: no answer` };
	}
	return { result: r };
}

function vcall(object, method, params) {
	const conn = vconnect();
	if (!conn)
		return { error: 'The vendor stack is not running' };
	const r = vcall_on(conn, object, method, params);
	conn.disconnect();
	return r;
}

function run_json(cmd) {
	const p = popen(cmd);
	if (!p)
		return { error: `cannot run ${cmd}` };
	const out = p.read('all');
	p.close();
	try {
		return json(out);
	}
	catch (e) {
		return { error: 'invalid answer', raw: substr(out ?? '', 0, 4000) };
	}
}

function shellquote(s) {
	return `'${replace(s, "'", "'\\''")}'`;
}

// OMCI reads take ~2 s per request to the stock daemon: never inside an
// rpcd call (rpcd would stop answering LuCI). Return the cache and leave a
// request for /usr/libexec/aero/omci-worker; the pages poll.
// seconds a reading is reused (aero.omci.cache_ttl)
function omci_ttl() {
	const v = +(cursor().get('aero', 'omci', 'cache_ttl') ?? 10);
	return (v > 0) ? v : 10;
}

// a read of <set> is asked for (/tmp/aero/omci.request.<set>) when a page
// opens or Refresh is pressed - never by the page following a running read
// (poll) - and the last completed read of the set is older than the TTL or
// a class was never read. r13: the cache counted as stale once its oldest
// class was older than the TTL, which a whole topology read always is, so
// every poll started the next read and the pages never settled.
function omci_cached(set, refresh, poll) {
	// stderr apart: a warning must not break the JSON, but explains a failure
	mkdir('/tmp/aero');
	let r = run_json(`/usr/sbin/aero ${set} --json --cached 2>/tmp/aero/cached.err`);
	if (type(r) != 'object' || (r.error && r.raw != null)) {
		const err = trim(readfile('/tmp/aero/cached.err') ?? '');
		return { error: `aero ${set} --json --cached: ${length(err) ? err : 'no answer'}` };
	}
	const req = `/tmp/aero/omci.request.${set}`;
	const done = stat(`/tmp/aero/omci.${set}.done`)?.mtime ?? 0;
	let missing = false;
	for (let c, me in (r.me ?? {}))
		if (me?.missing) missing = true;
	r.done = done;
	r.refreshing = !!(r.refreshing || access(req));
	if (!poll && !r.refreshing && (refresh || missing || time() - done >= omci_ttl())) {
		writefile(req, set);
		r.refreshing = true;
	}
	return r;
}

function hexstr(s) {
	let o = '';
	for (let i = 0; i < length(s); i++)
		o += sprintf('%02x', ord(s, i));
	return o;
}

// ucode does not hoist function declarations: every helper is declared
// above its first caller (r6-r10: run_json and math_rand were not, and the
// OMCI and *_encrypt methods threw "access to undeclared variable").
function math_rand() {
	const f = open('/dev/urandom', 'r');
	const b = f?.read(4) ?? '\0\0\0\0';
	f?.close();
	return (ord(b, 0) << 24 | ord(b, 1) << 16 | ord(b, 2) << 8 | ord(b, 3)) & 0x7fffffff;
}

// The stock web page encrypts password fields of the *_encrypt methods with
// AES-CBC (PKCS#7, base64) under the board key that the stock procd reports
// in `system board` (key = UTF-8 bytes of that string, IV = 16 x '0').
// The stock openssl in the chroot does the cipher; the clear text goes
// through a 0600 file on the vendor tmpfs, never on a command line.
let board_key = null;

function aes_encrypt(conn, plain) {
	if (board_key == null) {
		const b = vcall_on(conn, 'system', 'board', {});
		board_key = b.result?.key ?? '';
	}
	const bits = length(board_key) * 8;
	if (!(bits == 128 || bits == 192 || bits == 256))
		return null;

	mkdir('/vendor/tmp/aero');
	const name = sprintf('enc.%d.%d', time(), math_rand());
	const f = open(`/vendor/tmp/aero/${name}`, 'w', 384);	// 0600
	if (!f)
		return null;
	f.write(`${plain}`);
	f.close();

	const p = popen(`/usr/libexec/aero/run /usr/bin/openssl enc -aes-${bits}-cbc -K ${hexstr(board_key)} -iv ${AES_IV_HEX} -base64 -A -in /tmp/aero/${name} 2>/dev/null`);
	const out = p ? trim(p.read('all') ?? '') : '';
	p?.close();
	unlink(`/vendor/tmp/aero/${name}`);
	return length(out) ? out : null;
}

// encrypt the fields named by dotted paths ("snpwd", "bss.*.key") in place;
// "*" walks every element of an array or every member of an object
function encrypt_paths(conn, node, parts, i) {
	if (node == null || (type(node) != 'object' && type(node) != 'array'))
		return true;
	const k = parts[i];
	const last = (i == length(parts) - 1);
	const kids = (k == '*')
		? ((type(node) == 'array') ? map(node, (v, j) => j) : keys(node))
		: [ (type(node) == 'array') ? +k : k ];
	for (let kk in kids) {
		if (last) {
			if (type(node[kk]) == 'string' && length(node[kk])) {
				const enc = aes_encrypt(conn, node[kk]);
				if (enc == null)
					return false;
				node[kk] = enc;
			}
		}
		else if (!encrypt_paths(conn, node[kk], parts, i + 1))
			return false;
	}
	return true;
}

// stock UCI (the vendor overlay) for values skapid does not expose
function vuci() {
	return cursor('/vendor/etc/config', '/vendor/tmp/.uci');
}

function xpon_auth_conf(c) {
	for (let conf in [ 'pon', 'network' ])
		if (c.get(conf, 'xpon_auth'))
			return conf;
	return null;
}

// --- Status > Overview cards (view/status/include/1[56]_aero_*.js) --------
// Every open overview polls this every few seconds: the few stock readings
// the Fibre and WAN cards draw (no credentials), from one connection to the
// vendor bus, kept OVERVIEW_TTL s for the next tab. The static device data
// (GPON serial number, stock version) is read once per boot.
const OVERVIEW_CACHE = '/tmp/aero/overview.json';
const OVERVIEW_DEVINFO = '/tmp/aero/devinfo.json';
const OVERVIEW_TTL = 3;

function pick(o, keys) {
	const r = {};
	for (let k in keys)
		if (o?.[k] != null)
			r[k] = o[k];
	return r;
}

function running_bank() {
	const m = match(readfile('/proc/cmdline') ?? '', /bootflag=([0-9])/);
	return (m?.[1] == '1') ? 'tclinux_slave' : 'tclinux';
}

function overview_wan(w) {
	return {
		index: w.index, name: w.GUIname, enable: w.enable,
		type: w.v4_type, type6: w.v6_type, status: w.v4_status, status6: w.v6_status,
		uptime: w.v4_uptime, uptime6: w.v6_uptime, stack: w.IPStack,
		vlan: (w.vlanmode == 2) ? w.vlanid : null, prio: w.vlanpri, mtu: w.mtu,
		ifname: w.layer3interface, l2: w.layer2interface,
		ipaddr: w.ipaddr, mask: w.subnetmask, gateway: w.gateway,
		dns: filter([ w.dns1, w.dns2, w.dns3 ], (d) => d),
		gua: w.gua, prefix: w.prefix, gateway6: w.gatewayv6,
		dns6: filter([ w.dns1v6, w.dns2v6, w.dns3v6 ], (d) => d),
		defroute: w.is_defaultroute, defroute6: w.is_defaultroute_v6,
		rx: w.rx_Byte, tx: w.tx_byte, err: w.errcode
	};
}

function overview_read() {
	const now = time();
	const st = stat(OVERVIEW_CACHE);
	if (st && now - st.mtime < OVERVIEW_TTL && now >= st.mtime) {
		try { return json(readfile(OVERVIEW_CACHE)); } catch (e) {}
	}
	const res = { vendor: vendor_up(), time: now, bank: running_bank() };
	const conn = res.vendor ? vconnect() : null;
	if (!conn)
		return res;

	const link = vcall_on(conn, 'rtweb.poninfo', 'get_linkinfo', {});
	const opt = vcall_on(conn, 'rtweb.poninfo', 'get_optinfo', {});
	const txrx = vcall_on(conn, 'rtweb.poninfo', 'get_txrxsta', {});
	const wan = vcall_on(conn, 'gwweb.wancfg', 'status', {});
	const sys = vcall_on(conn, 'rtweb.devinfo', 'sysinfo', {});
	res.link = link.result ?? { error: link.error };
	res.opt = opt.result ?? { error: opt.error };
	res.txrx = pick(txrx.result, [ 'Rx_Bytes', 'Tx_Bytes', 'Rx_Packets', 'Tx_Packets',
		'Rx_FEC_Eror_Packets', 'Rx_HEC_Eror_Packets', 'Rx_Dropped_Packets', 'Tx_Dropped_Packets' ]);
	res.cpu_temp = sys.result?.cputemperature;
	res.wan = map(wan.result?.wan ?? [], overview_wan);

	let dev = null;
	try { dev = json(readfile(OVERVIEW_DEVINFO)); } catch (e) {}
	if (type(dev) != 'object') {
		const d = vcall_on(conn, 'rtweb.devinfo', 'get', {});
		if (d.result) {
			dev = pick(d.result, [ 'model', 'softver', 'hardver', 'gponsn', 'sn', 'manufac' ]);
			mkdir('/tmp/aero');
			writefile(OVERVIEW_DEVINFO, sprintf('%J', dev));
		}
	}
	res.dev = dev;
	conn.disconnect();

	mkdir('/tmp/aero');
	if (writefile(OVERVIEW_CACHE + '.tmp', sprintf('%J', res)) != null)
		rename(OVERVIEW_CACHE + '.tmp', OVERVIEW_CACHE);
	return res;
}

// --- Advanced > DDNS, Network > LAN > Encrypted DNS ------------------------
const DDNS = '/usr/libexec/aero/ddns';
const DNS_DROPIN = '/vendor/tmp/dnsmasq.d/aero-dns.conf';

function pid_of(name) {
	const p = popen(`pidof ${name} 2>/dev/null`);
	const out = trim(p?.read('all') ?? '');
	p?.close();
	return length(out) ? +split(out, ' ')[0] : null;
}

function dns_status() {
	const c = cursor();
	const mode = c.get('aero', 'dns', 'mode') ?? 'off';
	const conf = readfile(DNS_DROPIN) ?? '';
	const lines = filter(split(conf, '\n'), (l) => match(l, /^server=/));
	let wan = [];
	for (let f in [ '/vendor/tmp/resolv.conf.d/resolv.conf.auto', '/vendor/tmp/resolv.conf.auto' ]) {
		const r = readfile(f);
		if (r == null) continue;
		for (let l in split(r, '\n')) {
			const m = match(l, /^nameserver[ \t]+([^ \t]+)/);
			if (m) push(wan, m[1]);
		}
		break;
	}
	// DNS servers the stock DHCP servers hand out instead of the router
	// (stock LAN pages): those clients bypass the router, and its proxy
	const v = vuci();
	const v4 = [], v6 = [];
	const list = (x) => (type(x) == 'array') ? x : ((x != null) ? [ x ] : []);
	for (let o in list(v.get('dhcp', 'lan', 'dhcp_option'))) {
		const m = match(o, /^(option:)?(6|dns-server),(.+)$/);
		if (m) for (let a in split(m[3], ',')) if (a != '0.0.0.0') push(v4, a);
	}
	for (let a in list(v.get('dhcp', 'lan', 'dns')))
		push(v6, a);
	return {
		mode,
		dhcp_dns_v4: v4,
		dhcp_dns_v6: v6,
		doh_installed: !!access('/usr/sbin/https-dns-proxy', 'x'),
		dot_installed: !!access('/usr/sbin/stubby', 'x'),
		doh_pid: pid_of('https-dns-proxy'),
		dot_pid: pid_of('stubby'),
		dnsmasq_pid: pid_of('dnsmasq'),
		applied: length(conf) > 0,
		upstream: map(filter(lines, (l) => !match(l, /^server=\//)), (l) => substr(l, 7)),
		plain: map(filter(lines, (l) => match(l, /^server=\//)), (l) => substr(l, 7)),
		wan_dns: wan,
		clock_ok: localtime().year >= 2025,
		vendor: vendor_up()
	};
}

// one lookup through the router's own DNS (the stock dnsmasq, and the
// proxy behind it when encrypted DNS is on), timed
function dns_test(name) {
	if (!match(name ?? '', /^[A-Za-z0-9.-]{1,253}$/))
		name = 'openwrt.org';
	const t0 = clock(true);
	const p = popen(`nslookup -type=a ${name} 127.0.0.1 2>&1`);
	const out = p?.read('all') ?? '';
	const rc = p?.close();
	const t1 = clock(true);
	const ms = int((t1[0] - t0[0]) * 1000 + (t1[1] - t0[1]) / 1000000);
	const addrs = [];
	let past = false;
	for (let l in split(out, '\n')) {
		if (match(l, /^Name:/)) past = true;
		const m = past ? match(l, /^Address( [0-9]+)?:[ \t]*([0-9.]+)/) : null;
		if (m) push(addrs, m[2]);
	}
	return { name, ok: length(addrs) > 0, ms, addresses: addrs, output: substr(out, 0, 1000) };
}

// --- Advanced > WireGuard ----------------------------------------------------
const WG = '/usr/libexec/aero/wireguard';
const WG_KEY_RE = /^[A-Za-z0-9+\/]{42}[AEIMQUYcgkosw480]=$/;

function sh_out(cmd) {
	const p = popen(cmd);
	if (!p)
		return null;
	const out = p.read('all');
	return { out: out ?? '', rc: p.close() };
}

// a private key -> its public key; none -> a new key pair and a preshared key
function wg_keys(key) {
	if (key != null && length(key)) {
		if (!match(key, WG_KEY_RE))
			return { error: 'not a WireGuard key' };
		const r = sh_out(`printf '%s\n' ${shellquote(key)} | wg pubkey 2>/dev/null`);
		return { public_key: trim(r?.out ?? '') };
	}
	const priv = trim(sh_out('wg genkey 2>/dev/null')?.out ?? '');
	if (!match(priv, WG_KEY_RE))
		return { error: 'wg genkey failed (wireguard-tools missing?)' };
	return {
		private_key: priv,
		public_key: trim(sh_out(`printf '%s\n' ${shellquote(priv)} | wg pubkey 2>/dev/null`)?.out ?? ''),
		preshared_key: trim(sh_out('wg genpsk 2>/dev/null')?.out ?? '')
	};
}

// the client configuration of a peer whose key pair is kept here, and its
// QR code (SVG, qrencode)
function wg_client(sec) {
	if (!match(sec ?? '', /^[A-Za-z0-9_]+$/))
		return { error: 'invalid section' };
	mkdir('/var/run/aero-wg');
	const errf = '/var/run/aero-wg/client.err';
	const r = sh_out(`${WG} client ${sec} 2>${errf}`);
	if (r == null || r.rc != 0) {
		const e = trim(readfile(errf) ?? '');
		unlink(errf);
		return { error: length(e) ? e : 'no client configuration' };
	}
	unlink(errf);
	const conf = trim(r.out);
	const res = { config: conf };
	if (access('/usr/bin/qrencode', 'x')) {
		const q = sh_out(`printf '%s\n' ${shellquote(conf)} | qrencode -t SVG -l L -m 2 -o - 2>/dev/null`);
		if (q?.rc == 0 && length(q.out))
			res.qr = q.out;
	}
	return res;
}

const methods = {
	// Advanced > WireGuard: wg0, the peers' handshakes and traffic, the
	// endpoint for client configurations (/usr/libexec/aero/wireguard status)
	wg_status: {
		call: function() {
			const r = run_json(`${WG} status 2>/dev/null`);
			return (type(r) == 'object') ? r : { error: 'no WireGuard status' };
		}
	},

	wg_keys: {
		args: { private_key: 'private_key' },
		call: function(req) {
			return wg_keys(req.args?.private_key);
		}
	},

	wg_client: {
		args: { section: 'section' },
		call: function(req) {
			return wg_client(req.args?.section);
		}
	},

	// Advanced > DDNS: the address check, each entry's last result, the
	// stock entries (/usr/libexec/aero/ddns status)
	ddns_status: {
		call: function() {
			const r = run_json(`${DDNS} status`);
			return (type(r) == 'object') ? r : { error: 'no DDNS status' };
		}
	},

	// update every entry now: the service does it when it runs, else one
	// pass in the background (the page polls ddns_status)
	ddns_update: {
		call: function() {
			const st = run_json(`${DDNS} status`);
			const running = !!st?.running;
			system(running ? `${DDNS} update -f >/dev/null 2>&1` : `( ${DDNS} update -f >/dev/null 2>&1 & )`);
			return { ok: true, running };
		}
	},

	// Network > LAN > Encrypted DNS
	dns_status: {
		call: function() {
			return dns_status();
		}
	},

	dns_test: {
		args: { name: 'name' },
		call: function(req) {
			return dns_test(req.args?.name);
		}
	},

	// the Fibre and WAN cards of Status > Overview (cached, see above)
	overview: {
		call: function() {
			return overview_read();
		}
	},

	// the login banner for the splash screen after a LuCI login
	splash: {
		call: function() {
			const r = sh_out('/usr/libexec/aero/banner --layout 2>/dev/null');
			return r?.rc == 0 ? { layout: r.out } : { error: 'no banner' };
		}
	},

	// everything the Status > Overview page shows, in one round trip
	status: {
		call: function() {
			const res = { vendor: vendor_up() };
			const conn = res.vendor ? vconnect() : null;
			if (!conn)
				return res;

			const q = {
				pon_link: [ 'rtweb.poninfo', 'get_linkinfo' ],
				pon_opt: [ 'rtweb.poninfo', 'get_optinfo' ],
				pon_txrx: [ 'rtweb.poninfo', 'get_txrxsta' ],
				pon_cap: [ 'rtweb.poninfo', 'get_capsta' ],
				devinfo: [ 'rtweb.devinfo', 'get' ],
				sysinfo: [ 'rtweb.devinfo', 'sysinfo' ],
				netstatus: [ 'gwweb.netstatus', 'getNetStatus' ],
				wan: [ 'gwweb.wancfg', 'status' ],
				wanmode: [ 'gwweb.wancfg', 'get_wan_mode' ],
				ports: [ 'gwweb.portinfo', 'show_portinfo' ],
				stanum: [ 'rtweb.sta', 'getStaNum' ],
				onutype: [ 'gwweb.pon.sfu', 'get_onuType' ],
				lan: [ 'rtweb.lancfg', 'getLanCfg' ]
			};
			for (let k, v in q) {
				const r = vcall_on(conn, v[0], v[1], {});
				res[k] = r.result ?? { error: r.error };
			}
			conn.disconnect();
			return res;
		}
	},

	vget: {
		args: { object: 'object', method: 'method', params: {} },
		call: function(req) {
			const a = req.args;
			if (!allowed('read', a.object, a.method))
				return { error: `${a.object}.${a.method} is not an allowed read method` };
			return vcall(a.object, a.method, a.params);
		}
	},

	// several read calls in one request: calls = [ [object, method, params], ... ]
	vbatch: {
		args: { calls: [] },
		call: function(req) {
			const calls = req.args.calls ?? [];
			const conn = vconnect();
			if (!conn)
				return { error: 'The vendor stack is not running' };
			const out = [];
			for (let c in calls) {
				if (type(c) != 'array' || !allowed('read', c[0], c[1]))
					push(out, { error: `${c?.[0]}.${c?.[1]} is not an allowed read method` });
				else
					push(out, vcall_on(conn, c[0], c[1], c[2] ?? {}));
			}
			conn.disconnect();
			return { results: out };
		}
	},

	vset: {
		args: { object: 'object', method: 'method', params: {}, encrypt: [] },
		call: function(req) {
			const a = req.args;
			if (!allowed('write', a.object, a.method))
				return { error: `${a.object}.${a.method} is not an allowed write method` };
			const conn = vconnect();
			if (!conn)
				return { error: 'The vendor stack is not running' };
			const params = a.params ?? {};
			// the stock VPN page encrypts the password for gwweb.vpn add/edit too
			if (length(a.encrypt ?? []) && !match(a.method, /_encrypt$/) &&
			    !(a.object == 'gwweb.vpn' && (a.method == 'add' || a.method == 'edit'))) {
				conn.disconnect();
				return { error: 'encrypt is only valid for *_encrypt methods' };
			}
			for (let p in (a.encrypt ?? [])) {
				if (!encrypt_paths(conn, params, split(p, '.'), 0)) {
					conn.disconnect();
					return { error: 'The stock board key is not available, the value cannot be encrypted' };
				}
			}
			const r = vcall_on(conn, a.object, a.method, params);
			conn.disconnect();
			return r;
		}
	},

	// one ME class from the cache; a missing or stale one is requested
	me: {
		args: { class: 0 },
		call: function(req) {
			const c = +req.args.class;
			if (!(c > 0 && c < 65536))
				return { error: 'invalid ME class' };
			let r;
			try { r = json(readfile(`/tmp/aero/me.${c}.json`)); }
			catch (e) { r = { class: c, instances: [], missing: true }; }
			const st = stat(`/tmp/aero/me.${c}.json`);
			if (!st || time() - st.mtime >= omci_ttl()) {
				mkdir('/tmp/aero');
				writefile(`/tmp/aero/omci.request.${c}`, `${c}`);
				r.refreshing = true;
			}
			return r;
		}
	},

	olt: {
		args: { refresh: false, poll: false },
		call: function(req) {
			return omci_cached('olt', !!req.args.refresh, !!req.args.poll);
		}
	},

	topology: {
		args: { refresh: false, poll: false },
		call: function(req) {
			return omci_cached('topology', !!req.args.refresh, !!req.args.poll);
		}
	},

	vendor: {
		call: function() {
			const res = { up: vendor_up(), rc_done: !!access(VUP), mounted: false, services: {} };
			const m = readfile('/proc/mounts') ?? '';
			res.mounted = index(m, ' /vendor/proc ') >= 0;
			res.overlay = index(m, 'aero-vendor /vendor ') >= 0;
			const conn = res.up ? vconnect() : null;
			if (conn) {
				const s = vcall_on(conn, 'service', 'list', { verbose: true });
				for (let name, svc in (s.result ?? {})) {
					let running = 0, total = 0, exit_codes = [];
					for (let iname, inst in (svc.instances ?? {})) {
						total++;
						if (inst.running) running++;
						else if (inst.exit_code != null) push(exit_codes, inst.exit_code);
					}
					res.services[name] = { running, total, exit_codes };
				}
				conn.disconnect();
			}
			return res;
		}
	},

	// ONT authentication: what the stock GPON page shows, plus the serial
	// number from the stock UCI (xpon_auth).
	auth_get: {
		call: function() {
			const r = vcall('gwweb.poninfo', 'get', {});
			const res = { stock: r.result ?? null, error: r.error };
			const c = vuci();
			const conf = xpon_auth_conf(c);
			if (conf) {
				const s = c.get_all(conf, 'xpon_auth');
				res.uci = {
					config: conf,
					sn: s?.sn ?? '',
					def_sn: s?.def_sn ?? '',
					auth_type_g: s?.auth_type_g ?? '',
					gpon_sn_auth_type: s?.gpon_sn_auth_type ?? '',
					pon_mode: s?.pon_mode ?? ''
				};
			}
			return res;
		}
	},

	// args: auth_type sn|loid, password, loid, loid_password, sn (12 chars)
	auth_set: {
		args: { auth_type: 'auth_type', password: 'password', loid: 'loid', loid_password: 'loid_password', sn: 'sn' },
		call: function(req) {
			const a = req.args;
			const conn = vconnect();
			if (!conn)
				return { error: 'The vendor stack is not running' };
			const res = { applied: [] };

			let p;
			if (a.auth_type == 'loid' || a.auth_type == 'LOID')
				p = { auth_type: 'LOID', loid: a.loid ?? '', loidPasswd: a.loid_password ?? '' };
			else
				p = { auth_type: 'sn', snpwd: a.password ?? '' };

			if (a.password != null || a.loid != null || a.loid_password != null || a.auth_type != null) {
				for (let k in [ 'snpwd', 'loidPasswd' ]) {
					if (p[k] != null) {
						const enc = length(p[k]) ? aes_encrypt(conn, p[k]) : aes_encrypt(conn, '');
						if (enc == null && length(p[k])) {
							conn.disconnect();
							return { error: 'The stock board key is not available, the password cannot be encrypted' };
						}
						p[k] = enc ?? '';
					}
				}
				const r = vcall_on(conn, 'gwweb.poninfo', 'set_encrypt', p);
				if (r.error) {
					conn.disconnect();
					return r;
				}
				push(res.applied, 'auth');
			}
			conn.disconnect();

			if (a.sn != null && length(a.sn)) {
				if (!match(a.sn, /^[A-Za-z0-9]{4}[0-9A-Fa-f]{8}$/))
					return { error: 'The serial number must be 4 characters followed by 8 hexadecimal digits' };
				const c = vuci();
				const conf = xpon_auth_conf(c);
				if (!conf)
					return { error: 'xpon_auth not found in the stock configuration' };
				const sn = uc(substr(a.sn, 0, 4)) + uc(substr(a.sn, 4));
				if (c.get(conf, 'xpon_auth', 'sn') != sn) {
					c.set(conf, 'xpon_auth', 'sn', sn);
					c.commit(conf);
					system('/usr/libexec/aero/run /etc/init.d/pon restart >/dev/null 2>&1 &');
					push(res.applied, 'sn');
				}
			}
			return res;
		}
	}
};

return { aero: methods };
