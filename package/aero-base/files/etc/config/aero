# Aero-PON settings (LuCI: Aero-PON, System). The stock configuration of the
# vendor stack stays in /vendor/etc/config (its own UCI, own overlay).

config banner 'banner'
	# always | ssh (not on the serial console) | never
	option animate 'always'
	# auto | truecolor | 256 | 16 | none
	option color 'auto'
	# 1 = the banner as a splash screen after a LuCI login (not set: on).
	# It animates unless animate is never; color is for terminals only.
	option splash '1'

config vendor 'vendor'
	# 1 = run the stock EcoNet stack (PON/OMCI, WAN, switch, WiFi, VoIP) in
	# the /vendor chroot at boot. 0 = OpenWrt only (no fibre, no LAN bridge).
	option enabled '1'
	# Stock web GUI (uhttpd + rpcd of the stock firmware): off | local | lan
	# local = 127.0.0.1:8080 (ssh -L 8080:127.0.0.1:8080 root@192.168.0.1)
	option stockweb 'off'
	# TR-069 / USP agents of the ISP (easycwmpd, obuspa, tr069_*): off by
	# default, the ACS could reconfigure WAN, WiFi or VoIP behind OpenWrt.
	option tr069 '0'
	# Vendor cloud agents (APPManage, MeshUpgrade, skupgrade = firmware
	# push from the vendor/ISP cloud): never started while 0.
	option cloud '0'
	# Stock telnetd (skapid starts it; stock telnet account = root shell).
	option telnet '0'
	# Write the stock rc output to the serial console (1) or /tmp/log (0).
	option console '0'
	# Keep the vendor configuration on rootfs_data (/overlay/aero-vendor).
	# 0 = tmpfs: every boot restores it from /apps/backup/config.
	option persist '1'

config pon 'pon'
	# seconds a PON reading is reused by LuCI, the banner and `aero info`
	option cache_ttl '5'

config omci 'omci'
	# Arguments of the stock OMCI debug CLI that dump one ME class
	# (`omci <dump_cmd> <class> [<instance>]`); the answer goes to the
	# kernel log.
	option dump_cmd 'show pkt'
	# seconds a reading of OLT Status / OMCI Topology is reused: opening the
	# page within this time shows it, later opens read the daemon again
	option cache_ttl '10'
	# 1 = keep the dumps off the serial console while a request runs (they
	# stay in dmesg); 0 = print them on the UART as the stock firmware does
	option quiet_console '1'

config ui 'ui'
	# 1 = show developer pages (ONT Identity)
	option developer '0'

config dns 'dns'
	# Encrypted DNS for the LAN (DHCPv4, RA/DHCPv6: the router is the DNS
	# server) and the router itself: the stock dnsmasq sends lookups to a
	# local proxy instead of the ISP's DNS (LuCI: Network > LAN > Encrypted
	# DNS). off | doh (DNS over HTTPS, https-dns-proxy) | dot (DNS over TLS,
	# stubby)
	option mode 'doh'
	option doh_url 'https://b.hitoha.moe/dns-query'
	# plain DNS used only to look up the DoH resolver's host name
	option doh_bootstrap '1.1.1.1,1.0.0.1'
	option doh_port '5053'
	# DoT upstreams: "address@port#tls-name" (port 853 when left out)
	list dot_server '1.1.1.1#cloudflare-dns.com'
	list dot_server '1.0.0.1#cloudflare-dns.com'
	option dot_port '5453'
	# looked up through the WAN's (the ISP's) DNS in plain text: the clock
	# (NTP must work before TLS can), and domains of the ISP's own network
	list plain_domain 'pool.ntp.org'
	list plain_domain 'my.pool.ntp.org'

config ddns 'ddns'
	# Dynamic DNS (LuCI: Advanced > DDNS, /usr/libexec/aero/ddns): the A
	# records (IPv4) of the ddns_host entries follow the router's public
	# address. Replaces the stock DDNS client.
	option enabled '1'
	# The WAN whose address is published: auto = the one with the default
	# route (pppoe-wan_1 with PPPoE), or an interface name.
	option interface 'auto'
	# When that address is not public (carrier-grade NAT 100.64.0.0/10, a
	# private or reserved range), the address the internet sees comes from
	# the first of these that answers.
	list ip_url 'http://ip1.dynupdate.no-ip.com/'
	list ip_url 'https://api.ipify.org/'
	list ip_url 'https://ipv4.icanhazip.com/'
	option check_interval '600'
	option force_interval '86400'

config wireguard 'wireguard'
	# WireGuard (LuCI: Advanced > WireGuard, /usr/libexec/aero/wireguard):
	# interface wg0 for remote access (phones, laptops) and site-to-site
	# links. Peers get the access of a LAN device: the router, the LAN and
	# the internet (masqueraded). The module is built for the stock kernel's
	# own struct layout (docs/wireguard-feasibility.md).
	option enabled '0'
	option listen_port '51820'
	list address '10.7.0.1/24'
	# private_key: generated at the first start when not set.
	# mtu: not set = the WAN's MTU - 80 (1412 with PPPoE).
	# endpoint: the address in client configurations; not set = the first
	#   DDNS host name, else the WAN's public IPv4 address, else (behind
	#   CGNAT) a global IPv6 address of the router.
	# dns: the DNS server in client configurations; not set = the router's
	#   LAN address.

