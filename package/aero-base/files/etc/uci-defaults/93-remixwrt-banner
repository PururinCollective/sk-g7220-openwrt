# RemixWrt r17+: the login banner animates on the serial console too
# (aero.banner.animate default ssh -> always). A configuration kept from an
# older build still has the old default: moved to the new one. A script of
# its own, see 92-remixwrt-wireguard.

if [ "$(uci -q get aero.banner.animate)" = ssh ]; then
	uci -q set aero.banner.animate='always'
	uci -q commit aero
fi
exit 0
