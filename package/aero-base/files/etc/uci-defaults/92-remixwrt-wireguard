# RemixWrt r16+: the WireGuard section (Advanced > WireGuard) for a
# configuration kept from an older build. A script of its own: the overlay
# outlives sysupgrade, so a uci-defaults script that already ran in an older
# build (its whiteout stays in the overlay) never runs again under its old
# name. Only adds what is missing.

if ! uci -q get aero.wireguard >/dev/null; then
	uci -q batch <<UCI
set aero.wireguard=wireguard
set aero.wireguard.enabled='0'
set aero.wireguard.listen_port='51820'
add_list aero.wireguard.address='10.7.0.1/24'
UCI
	uci -q commit aero
fi
exit 0
