# RemixWrt r15+: the sections a configuration kept from an older build
# (sysupgrade with settings) does not have yet: encrypted DNS and DDNS.
# Runs after every upgrade (uci-defaults); only adds what is missing.

if ! uci -q get aero.dns >/dev/null; then
	uci -q batch <<UCI
set aero.dns=dns
set aero.dns.mode='doh'
set aero.dns.doh_url='https://b.hitoha.moe/dns-query'
set aero.dns.doh_bootstrap='1.1.1.1,1.0.0.1'
set aero.dns.doh_port='5053'
add_list aero.dns.dot_server='1.1.1.1#cloudflare-dns.com'
add_list aero.dns.dot_server='1.0.0.1#cloudflare-dns.com'
set aero.dns.dot_port='5453'
add_list aero.dns.plain_domain='pool.ntp.org'
add_list aero.dns.plain_domain='my.pool.ntp.org'
UCI
fi

if ! uci -q get aero.ddns >/dev/null; then
	uci -q batch <<UCI
set aero.ddns=ddns
set aero.ddns.enabled='1'
set aero.ddns.interface='auto'
add_list aero.ddns.ip_url='http://ip1.dynupdate.no-ip.com/'
add_list aero.ddns.ip_url='https://api.ipify.org/'
add_list aero.ddns.ip_url='https://ipv4.icanhazip.com/'
set aero.ddns.check_interval='600'
set aero.ddns.force_interval='86400'
UCI
fi
uci -q commit aero

# the packages' own services: aero-dns runs the proxies
for s in https-dns-proxy stubby; do
	[ -x "/etc/init.d/$s" ] && "/etc/init.d/$s" disable 2>/dev/null
done
exit 0
