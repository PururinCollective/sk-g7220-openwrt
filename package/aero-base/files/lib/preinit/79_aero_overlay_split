# Aero-PON: rootfs_data (jffs2) is shared by both firmware banks. Before
# 80_mount_root mounts it as the overlay, sort out who used it last:
#
# The stock bank ran (aero_stock_ran): upper/etc/config has skapi AND
# ucitrack. The stock image ships no /etc/config: every stock boot writes
# both (its preinit unpacks /apps/backup/config or the factory defaults when
# ucitrack is missing); OpenWrt 25.12 writes neither.
#
# 1. factory install - the stock bank ran (which is how -factory.bin is
#    flashed) and this image's build (AERO_PON_BUILD) has not booted here
#    before (.aero-build): the stock configuration in upper/ is copied to
#    RAM, rootfs_data is emptied, and the copy becomes the configuration of
#    the stock stack in the /vendor chroot (aero-vendor/upper/etc/config).
#    OpenWrt starts from its defaults.
# 2. back from the stock bank - the same, but this build has booted before:
#    upper/ is moved to stock-upper/ (vendor-boot takes its configuration
#    over once), a new upper/ is filled from aero-host.tgz (the OpenWrt
#    settings saved by /usr/libexec/aero/host-snapshot).
# 3. sysupgrade -n - .aero-wipe-host (platform_pre_upgrade): the OpenWrt
#    settings are reset, the stock configuration in the chroot stays.
# 4. factory reset - LuCI's reset (firstboot), the reset button and
#    `firstboot` all run fstools' factoryreset: rootfs_data emptied and its
#    state pending (.fs_state 1; mount_root empties it again on every boot
#    until one completes, so the mark goes to /tmp): no build booted here
#    and the stock bank did not run -> /tmp/.aero-factory-reset, the stock
#    stack resets too (vendor-boot -> /etc/aero/preinit.sh in the chroot,
#    as the stock firmware after `prolinecmd restore default`).
#
# A stock bank booted after this finds no stock configuration in upper/ and
# restores its own from /apps/backup/config.

aero_stock_ran() {
	[ -f "$1/upper/etc/config/skapi" ] && [ -f "$1/upper/etc/config/ucitrack" ]
}

# the decisions on the mounted rootfs_data ($1); $2 = this image's build
aero_split_dir() {
	local dir="$1" build="$2" n f last
	last=$(cat "$dir/.aero-build" 2>/dev/null)

	if [ -f "$dir/upper/etc/config/skapi" ] && ! aero_stock_ran "$dir"; then
		echo "- aero: upper/etc/config/skapi without ucitrack: not taken for a stock boot -"
	fi

	if [ -z "$last" ] && ! aero_stock_ran "$dir" && [ "$(readlink "$dir/.fs_state" 2>/dev/null)" != 2 ]; then
		echo "- aero: factory reset: the stock settings are reset too -"
		touch /tmp/.aero-factory-reset
	fi

	if aero_stock_ran "$dir" && [ -n "$build" ] && [ "$build" != "$last" ]; then
		echo "- aero: factory install ($build): taking over the stock settings, resetting rootfs_data -"
		rm -rf /tmp/aero-factory
		mkdir -p /tmp/aero-factory/config
		for f in "$dir"/upper/etc/config/*; do
			[ -f "$f" ] && [ ! -L "$f" ] && cp -p "$f" /tmp/aero-factory/config/
		done
		# everything but fstools' state link
		for f in "$dir"/* "$dir"/.[!.]*; do
			[ -e "$f" ] || [ -L "$f" ] || continue
			[ "${f##*/}" = .fs_state ] && continue
			rm -rf "$f"
		done
		mkdir -p "$dir/upper/etc" "$dir/aero-vendor/upper/etc/config"
		touch "$dir/upper/etc/aero-pon-owner"
		cp -p /tmp/aero-factory/config/* "$dir/aero-vendor/upper/etc/config/" 2>/dev/null
		echo factory > "$dir/aero-vendor/.seeded"
		rm -rf /tmp/aero-factory
		sync
	elif aero_stock_ran "$dir"; then
		echo "- aero: stock files in the overlay (stock bank ran), moving them to stock-upper/ -"
		rm -rf "$dir/stock-upper" "$dir/stock-work"
		mv "$dir/upper" "$dir/stock-upper"
		[ -d "$dir/work" ] && mv "$dir/work" "$dir/stock-work"
		mkdir -p "$dir/upper"
		if [ -s "$dir/aero-host.tgz" ] && tar -xzf "$dir/aero-host.tgz" -C "$dir/upper" 2>/dev/null; then
			echo "- aero: OpenWrt settings restored from aero-host.tgz -"
		fi
		mkdir -p "$dir/upper/etc"
		touch "$dir/upper/etc/aero-pon-owner"
		n=$(cat "$dir/.aero-split-count" 2>/dev/null)
		n=$(( ${n:-0} + 1 ))
		echo "$n" > "$dir/.aero-split-count"
		echo "$n" > "$dir/stock-upper/.aero-split"
		sync
	fi

	if [ -f "$dir/.aero-wipe-host" ]; then
		echo "- aero: sysupgrade without settings: resetting the OpenWrt settings -"
		rm -rf "$dir/upper" "$dir/work" "$dir/aero-host.tgz" "$dir/aero-host.md5" "$dir/.aero-wipe-host"
		mkdir -p "$dir/upper/etc"
		touch "$dir/upper/etc/aero-pon-owner"
		sync
	fi

	[ -n "$build" ] && [ "$build" != "$last" ] && echo "$build" > "$dir/.aero-build"
	return 0
}

aero_overlay_split() {
	local mtd dir=/tmp/aero-split build
	mtd=$(awk -F: '/"rootfs_data"/ { sub("mtd", "", $1); print $1; exit }' /proc/mtd)
	[ -n "$mtd" ] || return 0
	[ -e "/dev/mtdblock$mtd" ] || return 0
	mkdir -p "$dir"
	mount -t jffs2 "/dev/mtdblock$mtd" "$dir" 2>/dev/null || { rmdir "$dir"; return 0; }

	build=$(sed -n "s/^AERO_PON_BUILD='\(.*\)'$/\1/p" /etc/aero-pon-release 2>/dev/null)
	aero_split_dir "$dir" "$build"

	umount "$dir"
	rmdir "$dir"
}

boot_hook_add preinit_main aero_overlay_split
