# Aero-PON: the stock device tree says "econet,en7581"; give OpenWrt (LuCI,
# sysupgrade, the banner) the real board identity. Runs before 02_sysinfo,
# which only fills in missing values.

aero_sysinfo() {
	local AERO_PON_BOARD AERO_PON_MODEL
	[ -f /etc/aero-pon-release ] && . /etc/aero-pon-release
	mkdir -p /tmp/sysinfo
	echo "${AERO_PON_BOARD:-skyworth,sk-g7220}" > /tmp/sysinfo/board_name
	echo "${AERO_PON_MODEL:-Skyworth SK-G7220}" > /tmp/sysinfo/model
}

boot_hook_add preinit_main aero_sysinfo
