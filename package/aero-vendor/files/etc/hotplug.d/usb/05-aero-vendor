# Aero-PON: pass this kernel event on to the stock hotplug scripts in the
# /vendor chroot (the host procd receives all uevents). Sourced by
# hotplug-call in a subshell; ACTION, DEVICENAME, INTERFACE ... are kept.
[ -f /tmp/aero/vendor.up ] && [ -d "/vendor/etc/hotplug.d/$SUBSYSTEM" ] &&
	AERO_RUN_KEEPENV=1 /usr/libexec/aero/run /sbin/hotplug-call "$SUBSYSTEM" </dev/null >/dev/null 2>&1
