# The router's own lookups (apk, ntp, LuCI) go to the stock dnsmasq, which
# listens on 127.0.0.1 in the shared network namespace. The host netifd only
# manages the loopback and writes no resolver.
f=/tmp/resolv.conf.d/resolv.conf.auto
mkdir -p /tmp/resolv.conf.d
grep -q '^nameserver 127.0.0.1' "$f" 2>/dev/null || echo 'nameserver 127.0.0.1' > "$f"
[ -e /tmp/resolv.conf ] || ln -s "$f" /tmp/resolv.conf
exit 0
