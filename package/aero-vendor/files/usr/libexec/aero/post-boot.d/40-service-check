# Aero-PON: after the stock rc chain, report every stock procd instance that
# is not running and exited with an error. The stock procd sends their
# stderr nowhere, so for dnsmasq (exit 1 = configuration error, seen on r6)
# the reason is taken from `dnsmasq --test` on the generated configuration.
# Output: syslog (logread -e aero-vendor) and /tmp/log/aero-vendor.log.

sleep 20	# let respawning instances settle
/usr/libexec/aero/vubus -t 5 call service list '{"verbose":true}' 2>/dev/null |
	jsonfilter -e '@[*].instances[*]' 2>/dev/null >/dev/null || exit 0

/usr/libexec/aero/vubus -t 5 call service list '{"verbose":true}' 2>/dev/null | awk '
	# "name": { ... "instances": { "inst": { "running": false, ... "exit_code": 1
	/^\t"[^"]+": \{$/ { split($0, a, "\""); svc = a[2] }
	/^\t\t\t"[^"]+": \{$/ { split($0, a, "\""); inst = a[2]; run = ""; code = "" }
	/"running": / { run = ($0 ~ /true/) ? 1 : 0 }
	/"exit_code": / { code = $0; gsub(/[^0-9]/, "", code); if (!run && code != "" && code != 0) print svc, inst, code }
' | while read -r svc inst code; do
	logger -t aero-vendor "stock service $svc ($inst) is not running, exit code $code"
	echo "$(date '+%F %T') stock service $svc ($inst) is not running, exit code $code" >> /tmp/log/aero-vendor.log
	if [ "$svc" = dnsmasq ]; then
		for f in /vendor/var/etc/dnsmasq.conf.*; do
			[ -f "$f" ] || continue
			/usr/libexec/aero/run /usr/sbin/dnsmasq --test -C "/var/etc/${f##*/}" 2>&1 |
				logger -t aero-vendor
		done
	fi
done
exit 0
