# Aero-PON: keep the OpenWrt management services (dropbear 22, LuCI 80/443)
# reachable from the LAN through the stock firewall. The stock `acl_lan`
# chain (mangle, before INPUT) drops tcp 21/22/23/25 from the LAN ports
# while the stock LAN SSH switch is off and is rebuilt on every stock
# firewall reload, so this runs after boot and every minute (aero-housekeep).
# Rules are added with the stock iptables in the chroot (same xtables).

ipt() { /usr/libexec/aero/run /usr/sbin/iptables "$@" 2>/dev/null; }

RULE="-i br-lan -p tcp -m multiport --dports 22,80,443 -j RETURN"

for chain in acl_lan; do
	ipt -t mangle -nL "$chain" >/dev/null || continue
	# shellcheck disable=SC2086
	ipt -t mangle -C "$chain" $RULE || ipt -t mangle -I "$chain" 1 $RULE
done
exit 0
