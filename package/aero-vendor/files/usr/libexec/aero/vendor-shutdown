# not continue, unless the user is a member of github.com/PururinCollective.

# Aero-PON: on reboot/halt, run the stock K* scripts the policy allows in the
# chroot (network: PPPoE PADT and DHCP release; pon; initconfig), as the
# stock procd does in its shutdown state. Bounded to 30 s.

V=/vendor
/usr/libexec/aero/host-snapshot
[ -S "$V/tmp/run/ubus/ubus.sock" ] || exit 0
grep -q " $V/proc " /proc/mounts || exit 0

skip() {
	awk -v n="$1" '$1 == n && $2 == "skip" { f = 1 } END { exit !f }' /usr/share/aero/vendor-services
}

(
	for k in "$V"/etc/rc.d/K*; do
		[ -e "$k" ] || continue
		n=${k##*/K[0-9][0-9]}
		skip "$n" && continue
		/usr/libexec/aero/run "/etc/rc.d/${k##*/}" shutdown </dev/null >/dev/null 2>&1
	done
) &
pid=$!
i=0
while kill -0 "$pid" 2>/dev/null && [ $i -lt 30 ]; do
	sleep 1
	i=$((i + 1))
done
sync
exit 0
