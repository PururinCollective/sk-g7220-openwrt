# Aero-PON: bring up the stock EcoNet userland in the /vendor chroot.
#
#   vendor-boot mount   mount the chroot: writable overlay on /vendor, proc,
#                       sys, the host /dev (rbind), its own tmpfs on /tmp
#                       (the stock /var is a link to tmp). Synchronous, from
#                       /etc/init.d/aero-vendor before the vendor ubusd and
#                       procd instances start.
#   vendor-boot rc      the stock boot: vendor preinit (/apps, configuration
#                       recovery), then every stock /etc/rc.d/S* script the
#                       policy table allows (/usr/share/aero/vendor-services),
#                       on the vendor procd and ubusd. Then the post-boot.d
#                       hooks. Runs as a procd instance in the background.
#   vendor-boot status  what is mounted and running
#
# The stock userland is OpenWrt 21.02 (procd, ubus, netifd, fw3), so it runs
# on its own message bus (/vendor/tmp/run/ubus/ubus.sock) with its own procd
# (not PID 1: `procd -s <socket>` only serves the service/system objects).
# Its netifd owns the LAN bridge, the PON WAN services and the hardware NAT;
# the host's netifd only the loopback.

. /lib/functions.sh

V=/vendor
LOG=/tmp/log/aero-vendor.log
STATE=/tmp/aero
RC_TIMEOUT=60
UP="$STATE/vendor.up"
POLICY=/usr/share/aero/vendor-services
VSOCK="$V/tmp/run/ubus/ubus.sock"

config_load aero
config_get stockweb vendor stockweb off
config_get_bool tr069 vendor tr069 0
config_get_bool cloud vendor cloud 0
config_get_bool console vendor console 0
config_get_bool persist vendor persist 1
config_get_bool telnet vendor telnet 0

mkdir -p "$STATE" /tmp/log

log() {
	logger -t aero-vendor "$*"
	echo "$(date '+%F %T') $*" >> "$LOG"
}

is_mounted() {
	grep -q " $1 " /proc/mounts
}

rc_out() {
	if [ "$console" = 1 ]; then echo /dev/console; else echo "$LOG"; fi
}

do_mount() {
	[ -x "$V/sbin/procd" ] && [ -x "$V/sbin/ubusd" ] || {
		log "$V is incomplete (no procd/ubusd), vendor stack not started"
		return 1
	}

	# Writable layer: the stock scripts write /etc/config, /etc/wireless,
	# /apps ... The lower layer is the image's /vendor (directly from the
	# squashfs when /rom is there: one overlay level less).
	if ! is_mounted "$V"; then
		local lower="$V" base="$STATE/vendor-rw"
		[ -d "/rom$V/etc" ] && lower="/rom$V"
		if [ "$persist" = 1 ] && is_mounted /overlay && touch /overlay/.aero-rw 2>/dev/null; then
			rm -f /overlay/.aero-rw
			base=/overlay/aero-vendor
		fi
		mkdir -p "$base/upper" "$base/work"
		seed_config "$base"
		if mount -t overlay aero-vendor \
			-o "lowerdir=$lower,upperdir=$base/upper,workdir=$base/work" "$V"; then
			log "vendor tree: overlay $lower + $base"
		else
			log "vendor tree: overlay failed, running read-only"
		fi
	fi

	is_mounted "$V/proc" || mount -t proc proc "$V/proc"
	is_mounted "$V/sys" || mount -t sysfs sysfs "$V/sys"
	is_mounted "$V/dev" || mount -o rbind /dev "$V/dev"
	is_mounted "$V/tmp" || mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs "$V/tmp"

	mkdir -p "$V/tmp/run/ubus" "$V/tmp/lock" "$V/tmp/log" "$V/tmp/state" \
		"$V/tmp/.uci" "$V/tmp/aero" "$V/apps" "$V/tmp/dnsmasq.d"
	chmod 0700 "$V/tmp/.uci"
	# encrypted DNS: the stock dnsmasq reads its drop-in from the start
	/usr/libexec/aero/dns-apply boot
	# board identity for the vendor procd (`system board`) and scripts
	[ -d /tmp/sysinfo ] && cp -a /tmp/sysinfo "$V/tmp/"
	# the stock libc and daemons read the zone from /tmp/TZ
	[ -f /tmp/TZ ] && cp /tmp/TZ "$V/tmp/TZ"
	# written by tccicmd.ko at preinit into the host /etc
	[ -f /etc/fwTCver.conf ] && cp /etc/fwTCver.conf "$V/etc/fwTCver.conf" 2>/dev/null
	# BOSA calibration. The stock S00xponconfig loads econet_bob.ko, which runs
	# `/sbin/ecnt_sys get bob 7570` through call_usermodehelper - in PID 1's
	# root, so it writes the HOST /tmp/7570_bob.conf - and then en7571.ko, which
	# reads /tmp/7570_bob.conf while insmod runs in the chroot: /vendor/tmp.
	# Without it the laser driver runs uncalibrated (r6: "Error opening",
	# "Uncalibrated DUT", no DDMI = no optical readings). Read it from "art"
	# with the same stock tool now and give the chroot a copy.
	if [ ! -s "$V/tmp/7570_bob.conf" ]; then
		[ -s /tmp/7570_bob.conf ] || /sbin/ecnt_sys get bob 7570 >/dev/null 2>&1
		if [ -s /tmp/7570_bob.conf ]; then
			cp /tmp/7570_bob.conf "$V/tmp/7570_bob.conf"
			log "BOSA calibration /tmp/7570_bob.conf: $(wc -c < /tmp/7570_bob.conf) bytes from art"
		else
			log "BOSA calibration: /tmp/7570_bob.conf not readable from art, the EN7571 laser driver runs uncalibrated"
		fi
	fi

	# stock telnetd (started by skapid) only on request
	if [ "$telnet" = 1 ]; then touch "$V/tmp/aero/telnet"; else rm -f "$V/tmp/aero/telnet"; fi

	# OpenWrt's preinit takes eth0 as its failsafe interface (armsr board
	# default) and sets it down at the end of preinit (preinit_ip_deconfig),
	# undoing the `eth0 up` of 81_aero_hwinit: the LAN port VLANs eth0.N and
	# br-lan then carry nothing (r3). The stock preinit leaves it up.
	ip link set dev eth0 up 2>/dev/null || ifconfig eth0 up
	return 0
}

# The stock bank and Aero-PON share rootfs_data. After a boot of the stock
# bank, 79_aero_overlay_split moved the overlay the stock userland used to
# /overlay/stock-upper and numbered the round trip (.aero-split): its
# /etc/config is the live stock configuration (ISP provisioning, PPPoE,
# WiFi, VoIP), newer than anything in the chroot. Take it over once per
# round trip (regular files only), before the overlay is mounted.
seed_config() {
	local base="$1" src=/overlay/stock-upper n f
	[ -f "$src/.aero-split" ] && [ -d "$src/etc/config" ] || return 0
	n=$(cat "$src/.aero-split")
	[ "$n" = "$(cat "$base/.seeded" 2>/dev/null)" ] && return 0
	mkdir -p "$base/upper/etc/config"
	for f in "$src"/etc/config/*; do
		[ -f "$f" ] && [ ! -L "$f" ] && cp -p "$f" "$base/upper/etc/config/"
	done
	echo "$n" > "$base/.seeded"
	log "stock configuration taken over from the stock bank (round trip $n)"
}

# policy NAME -> run|skip|stockweb|tr069|cloud
policy() {
	local p
	p=$(awk -v n="$1" '$1 == n { print $2; exit }' "$POLICY" 2>/dev/null)
	echo "${p:-run}"
}

allowed() {
	case "$(policy "$1")" in
		run) return 0 ;;
		stockweb) [ "$stockweb" != off ] ;;
		tr069) [ "$tr069" = 1 ] ;;
		cloud) [ "$cloud" = 1 ] ;;
		*) return 1 ;;
	esac
}

# one stock rc script, at most RC_TIMEOUT s: a script that does not return
# (r2: the WiFi scripts without their profile) must not hold back the rest of
# the chain (led, skapi = rtweb.*, voip). It keeps running in the background.
run_rc() {
	local i=0 pid
	/usr/libexec/aero/run "/etc/rc.d/$1" boot </dev/null >>"$(rc_out)" 2>&1 &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		if [ $i -ge $RC_TIMEOUT ]; then
			log "$1 still running after ${RC_TIMEOUT} s, continuing"
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	wait "$pid" 2>/dev/null
	return 0
}

wait_vendor_bus() {
	local i=0
	while [ $i -lt 30 ]; do
		[ -S "$VSOCK" ] && /usr/libexec/aero/vubus -t 2 list service >/dev/null 2>&1 && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

do_rc() {
	if [ -f "$UP" ]; then
		log "vendor stack already up"
		return 0
	fi
	is_mounted "$V/proc" || do_mount || return 1

	log "vendor preinit (/apps, configuration recovery)"
	# a factory reset of the host (79_aero_overlay_split) resets the stock
	# configuration too. aero/run starts from an empty environment: the
	# settings go in with env, inside the chroot.
	local reset=0
	[ -f /tmp/.aero-factory-reset ] && reset=1 && log "factory reset: the stock settings go back to the factory defaults"
	/usr/libexec/aero/run /usr/bin/env AERO_STOCKWEB="$stockweb" AERO_FACTORY_RESET="$reset" \
		/bin/sh /etc/aero/preinit.sh </dev/null >>"$(rc_out)" 2>&1 && rm -f /tmp/.aero-factory-reset

	if ! wait_vendor_bus; then
		log "vendor ubus/procd not answering after 30 s, stock services not started"
		return 1
	fi

	# The stock OMCI daemon (started by `pon`) probes the LAN ports with MII
	# ioctls. Without the EN8811H 2.5G PHY driver, the probe of LAN1 (eth0.5)
	# calls a NULL mdio_read in eth.ko and oopses with the RTNL lock held: the
	# whole network stack hangs (r1). Keep the box reachable instead.
	local pon_guard=0
	if grep -q 'serdes_ethernet=112' /proc/cmdline && ! grep -q '^air_en8811h ' /proc/modules; then
		pon_guard=1
		log "EN8811H 2.5G PHY driver not loaded: the stock pon/OMCI service is NOT started (see 81_aero_hwinit)"
	fi

	local s n t0 t1
	t0=$(cut -d. -f1 /proc/uptime)
	for s in "$V"/etc/rc.d/S*; do
		[ -e "$s" ] || continue
		n=${s##*/S[0-9][0-9]}
		if [ "$n" = pon ] && [ "$pon_guard" = 1 ]; then
			echo "aero-vendor: skip ${s##*/} (no 2.5G PHY driver)" >> "$LOG"
			continue
		fi
		if ! allowed "$n"; then
			echo "aero-vendor: skip ${s##*/} ($(policy "$n"))" >> "$LOG"
			continue
		fi
		echo "aero-vendor: boot ${s##*/}" >> "$LOG"
		run_rc "${s##*/}"
	done
	t1=$(cut -d. -f1 /proc/uptime)
	log "stock rc chain done in $((t1 - t0)) s"

	/usr/libexec/aero/var-mirror
	touch "$UP"

	for hook in /usr/libexec/aero/post-boot.d/*; do
		[ -x "$hook" ] || continue
		log "post-boot: ${hook##*/}"
		"$hook" >> "$LOG" 2>&1
	done
}

do_status() {
	local m
	for m in "$V" "$V/proc" "$V/sys" "$V/dev" "$V/tmp" "$V/apps"; do
		if is_mounted "$m"; then echo "mounted   $m"; else echo "-         $m"; fi
	done
	[ -S "$VSOCK" ] && echo "ubus      $VSOCK" || echo "ubus      (no socket)"
	[ -f "$UP" ] && echo "rc        done" || echo "rc        not done"
	/usr/libexec/aero/vubus -t 2 call service list 2>/dev/null |
		awk -F'"' '/^\t"[^"]+": \{/ { printf "service   %s\n", $2 }'
}

case "$1" in
	mount) do_mount ;;
	rc) do_rc ;;
	status) do_status ;;
	*) echo "usage: $0 mount|rc|status" >&2; exit 1 ;;
esac
