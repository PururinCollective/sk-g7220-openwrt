# ubus client on the vendor message bus (the stock ubusd in /vendor). The
# OpenWrt 25.12 ubus client speaks the 21.02 protocol (verified on-device).
#   /usr/libexec/aero/vubus call rtweb.poninfo get_optinfo
#   /usr/libexec/aero/vubus list

exec ubus -s /vendor/tmp/run/ubus/ubus.sock "$@"
