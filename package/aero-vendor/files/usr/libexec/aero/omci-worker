# Aero-PON: reads OMCI MEs for LuCI in the background. rpcd (aero.olt,
# aero.topology, aero.me) leaves /tmp/aero/omci.request.<set> when a page is
# opened (or Refresh pressed) and its last read is older than
# aero.omci.cache_ttl, and returns at once with the cached data; this loop
# runs `aero omci-refresh <set>` and marks the read done
# (/tmp/aero/omci.<set>.done). One file per set: OLT Status and OMCI
# Topology open at the same time do not cancel each other.

mkdir -p /tmp/aero
while :; do
	for req in /tmp/aero/omci.request.*; do
		[ -f "$req" ] || continue
		set=${req##*/omci.request.}
		rm -f "$req"
		case "$set" in
			olt|topology|[0-9]*) ;;
			*) continue ;;
		esac
		/usr/sbin/aero omci-refresh "$set" >/dev/null 2>&1
		touch "/tmp/aero/omci.$set.done"
	done
	sleep 1
done
