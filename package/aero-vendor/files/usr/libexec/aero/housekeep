# RemixWrt housekeeping, every 60 s (aero-housekeep): LAN management rules,
# the /tmp mirror of the vendor /tmp, the host resolver, the encrypted DNS
# drop-in (the WAN's DNS servers change with the WAN), the WireGuard rules
# in the stock firewall (rebuilt on WAN changes), and the size of the OMCI
# daemon log.

while :; do
	if [ -f /tmp/aero/vendor.up ]; then
		/usr/libexec/aero/lan-mgmt
		/usr/libexec/aero/var-mirror
		/usr/libexec/aero/post-boot.d/30-resolv >/dev/null 2>&1
		/usr/libexec/aero/dns-apply
		/usr/libexec/aero/host-snapshot
		[ -x /usr/libexec/aero/wireguard ] && /usr/libexec/aero/wireguard firewall
		f=/vendor/tmp/aero/omci.out
		[ -f "$f" ] && [ "$(wc -c < "$f")" -gt 1048576 ] && : > "$f"
	fi
	sleep 60
done
