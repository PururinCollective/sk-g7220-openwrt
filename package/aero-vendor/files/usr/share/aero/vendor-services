# Aero-PON: what the vendor boot does with each stock /etc/rc.d/S* script
# inside the /vendor chroot. Scripts not listed here run.
#
#   run       run it (the stock stack: PON/OMCI, netifd, fw3, dnsmasq, WiFi...)
#   skip      never: the OpenWrt 25.12 host owns it
#   stockweb  only with aero.vendor.stockweb != off (stock web GUI)
#   tr069     only with aero.vendor.tr069 = 1 (ISP remote management)
#   cloud     only with aero.vendor.cloud = 1 (vendor cloud agents)
#
# name            policy    reason
sysfixtime        skip      host restores the clock (S00sysfixtime)
urngd             skip      host entropy daemon
fstab             skip      host mounts (fstools); /apps is mounted by the vendor preinit
log               skip      vendor syslog() reaches the host logd through the shared /dev/log
dropbear          skip      host dropbear owns port 22
uhttpd            stockweb  host uhttpd (LuCI) owns ports 80/443
rpcd              stockweb  only the stock web GUI talks to the vendor rpcd
sysntpd           skip      host sysntpd keeps the clock
ddns              skip      RemixWrt DDNS (/usr/libexec/aero/ddns, Advanced > DDNS) replaces the stock client
urandom_seed      skip      host
umount            skip      host
sky_telnet_for_factory skip factory telnet
easycwmpd         tr069     TR-069 CPE agent
obuspa            tr069     TR-369 (USP) agent
tr069_stund       tr069     TR-069 STUN
tr069_udp         tr069     TR-069 UDP connection request
tr069_udpechoclient tr069   TR-143 UDP echo
bulkdatad         tr069     TR-069 bulk data upload
APPManage         cloud     vendor app manager
MeshUpgrade       cloud     mesh firmware push
skupgrade         cloud     vendor/ISP firmware push (would flash the other bank)
zzz_sky_up_status_check cloud vendor cloud status report
